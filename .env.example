# Copy to .env and fill in.

# API key for OpenAI or any OpenAI-compatible provider.
OPENAI_API_KEY=

# Optional. Leave empty for OpenAI. Set to use another OpenAI-compatible provider, e.g.:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# Model name as the provider expects it.
MODEL=gpt-4.1-mini

# Optional. Fixes "today" for the agent (YYYY-MM-DD or YYYY-MM-DDTHH:MM; 10:00 if no time).
# The data ends in March 2026, so a fixed date keeps return windows and examples reproducible.
# Empty = real current time in the store's timezone (America/Campo_Grande).
REFERENCE_DATE=2026-03-25T10:00
